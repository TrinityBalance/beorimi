# VLM
OPENAI_API_KEY=your_api_key_here
VLM_PROVIDER=openai
OPENAI_VLM_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=60
VLM_MAX_UPLOAD_MB=10
VLM_SERVICE_TOKEN=replace_with_a_long_random_value

# Backend
APP_NAME=Beorimi API
VLM_BASE_URL=http://localhost:8001
VLM_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=4194304
CORS_ALLOW_ORIGINS=http://localhost:3000
AWS_REGION=ap-northeast-2
IMAGE_BUCKET_NAME=
ANALYSIS_TABLE_NAME=
ANALYSIS_QUEUE_URL=
PRESIGNED_URL_TTL_SECONDS=300
MAX_SOURCE_IMAGE_BYTES=10485760
ANALYSIS_RETENTION_DAYS=30
ANALYSIS_ACCOUNT_LIMIT=5
ANALYSIS_MAX_RECEIVE_COUNT=3
