{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vlm-analysis-result.json",
  "title": "VlmAnalysisResult",
  "description": "VLM과 Backend worker 사이의 내부 분석 응답",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation", "guardrail"],
  "properties": {
    "observation": { "$ref": "analysis-response.json" },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_injection_detected", "risk_level", "signals"],
      "properties": {
        "prompt_injection_detected": { "type": "boolean" },
        "risk_level": {
          "type": "string",
          "enum": ["none", "low", "high"]
        },
        "signals": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "instruction_like_text",
              "system_prompt_extraction",
              "schema_manipulation",
              "tool_or_action_request",
              "credential_or_secret_request",
              "policy_bypass_request"
            ]
          }
        }
      }
    }
  }
}
